<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>AxiomVerge.Breach.mm</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OuterBeyond</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Publicize Include="AxiomVerge" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AxiomVerge">
      <HintPath>..\..\libs\AxiomVerge.exe</HintPath>
      <Aliases>global,vanilla</Aliases>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>..\..\libs\FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>..\..\libs\log4net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\API\Breach.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the same as API assembly -->
    <PackageReference Include="MonoMod" Version="22.7.31.1">
      <ExcludeAssets>none</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="MonoMod.RuntimeDetour" Version="22.7.31.1">
      <ExcludeAssets>none</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0626;CS0414</NoWarn>
  </PropertyGroup>

</Project>